# Twenty CRM — external services (Supabase + Upstash)
# Copy to .env and fill in values. Do NOT commit .env.

TAG=latest

# Public URL after deploy (e.g. https://twenty-server.onrender.com)
SERVER_URL=https://your-app.onrender.com

# Supabase Session pooler (IPv4 — required for Render). Do NOT add ?sslmode=require
# here; it bypasses PG_SSL_ALLOW_SELF_SIGNED. Set PG_SSL_ALLOW_SELF_SIGNED=true instead.
# postgresql://postgres.[ref]:[PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
PG_DATABASE_URL=

# Required when using Supabase pooler from Render
PG_SSL_ALLOW_SELF_SIGNED=true

# Upstash Redis → REST or rediss URL (Twenty expects redis:// or rediss://)
# Create at https://console.upstash.com/redis
REDIS_URL=

# Generate with: openssl rand -base64 32  (or scripts/generate-secrets.ps1)
ENCRYPTION_KEY=

STORAGE_TYPE=local

# Optional: Supabase Storage (S3-compatible) for production file uploads
# STORAGE_TYPE=S_3
# STORAGE_S3_REGION=ap-south-1
# STORAGE_S3_NAME=twenty-files
# STORAGE_S3_ENDPOINT=https://[project-ref].supabase.co/storage/v1/s3
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
